# Copy to .env and fill in. Never commit the filled copy.
# On Render these go in the dashboard's Environment tab, not in a file.

PORT=5001
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Local dev: a system mongod, or leave it and let the embedded fallback start.
# Hosted: an Atlas connection string, and USE_EMBEDDED_MONGO must stay false —
# the embedded server is refused outright when NODE_ENV=production.
MONGODB_URI=mongodb://localhost:27017/spinevision
USE_EMBEDDED_MONGO=true
# Hosted (Render) values, for reference — note the /spinevision database name
# before the query string, without which Atlas drops everything into "test":
#   MONGODB_URI=mongodb+srv://Karam:<password>@cluster0.7mvcio2.mongodb.net/Spine_Vision?retryWrites=true&w=majority&appName=Cluster0
#   USE_EMBEDDED_MONGO=false
EMBEDDED_MONGO_PORT=27018
EMBEDDED_MONGO_DBPATH=./.mongo-data

# --- Auth -------------------------------------------------------------------
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# --- HTTP -------------------------------------------------------------------
# Comma-separated. In development any localhost port is allowed regardless.
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# --- ML ---------------------------------------------------------------------
PYTHON_PATH=../ml/venv/bin/python3
ML_DIR=../ml
ML_ENABLED=true
SEGMENTATION_ENABLED=true
SEGMENTATION_WEIGHTS=models/best.pt
# The checkpoint is git-ignored. On a host that builds from the repo, point
# this at a direct download (GitHub Release asset, Hugging Face) and the
# prestart hook fetches it once per boot. Leave empty locally.
SEGMENTATION_WEIGHTS_URL=
SEGMENTATION_TIMEOUT_MS=180000
ML_SCRIPT_TIMEOUT_MS=120000

# --- LLM --------------------------------------------------------------------
# Unset, the report falls back to the deterministic template built from the
# same measurements.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Only when the key is not from OpenAI directly. Must be the base, e.g.
# https://host/v1
OPENAI_BASE_URL=
LLM_INCLUDE_IMAGES=false
