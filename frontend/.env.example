# Vite inlines these at BUILD time. On Vercel set them in the project's
# Environment Variables, not in a committed file.

# Local: http://localhost:5001 — hosted: your Render URL.
VITE_API_BASE_URL=http://localhost:5001

# Prototype mode: fake auth + a simulated pipeline, no backend needed.
# Only the exact string "true" enables it.
VITE_USE_MOCK=false
